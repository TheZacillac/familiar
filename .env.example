# Model — uses provider:model format
# Examples:
#   ollama:nemotron-3-nano:latest   (local, default)
#   openai:gpt-4o                   (requires OPENAI_API_KEY)
#   anthropic:claude-sonnet-4-20250514       (requires ANTHROPIC_API_KEY)
#   google_genai:gemini-2.5-pro     (requires GOOGLE_API_KEY)
FAMILIAR_MODEL=ollama:nemotron-3-nano:latest

# Ollama (only needed for ollama provider)
OLLAMA_BASE_URL=http://localhost:11434

# API keys (set the one matching your provider)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ─── Claude Agent SDK engine (familiar-claude) ─────────────────────────────
# Run `familiar-claude` instead of `familiar` to use Anthropic's Claude Agent
# SDK as the agent loop. FAMILIAR_MODEL above is ignored on this path.
# Pick exactly ONE auth method:
#
#   1. Subscription (Pro/Max/Team/Enterprise) — recommended if you already
#      pay for Claude. Run `claude setup-token` once to mint a long-lived
#      OAuth token, then set:
# CLAUDE_CODE_OAUTH_TOKEN=
#
#   2. Per-token API billing — get a key from console.anthropic.com and
#      reuse the ANTHROPIC_API_KEY above. The SDK picks it up automatically.
#
#   3. Cloud provider — set one of:
# CLAUDE_CODE_USE_BEDROCK=1     # plus AWS creds
# CLAUDE_CODE_USE_VERTEX=1      # plus GCP creds
# CLAUDE_CODE_USE_FOUNDRY=1     # plus Azure creds
#
# Override the default model (claude-sonnet-4-6):
# FAMILIAR_CLAUDE_MODEL=claude-opus-4-7

# LangSmith tracing (optional — pip install -e ".[tracing]")
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=familiar
